# React App Configuration
VITE_API_URL=/api
# Optional; defaults to the frontend origin and uses the dev proxy.
# VITE_SOCKET_URL=http://localhost:5000

# Features Toggle
REACT_APP_ENABLE_PAYMENTS=true
REACT_APP_ENABLE_NOTIFICATIONS=true

# Google OAuth (for student/parent login)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id

# Analytics (if any)
REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X

# File Upload Limits
REACT_APP_MAX_FILE_SIZE=5242880  # 5MB
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/webp,application/pdf